<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.pawfinder.app.ui.auth.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_feedFragment"
            app:destination="@id/feedFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.pawfinder.app.ui.auth.RegisterFragment"
        android:label="Register">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_registerFragment_to_feedFragment"
            app:destination="@id/feedFragment" />
    </fragment>

    <fragment
        android:id="@+id/feedFragment"
        android:name="com.pawfinder.app.ui.feed.FeedFragment"
        android:label="Home">
        <action
            android:id="@+id/action_feedFragment_to_postDetailsFragment"
            app:destination="@id/postDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/postDetailsFragment"
        android:name="com.pawfinder.app.ui.post.PostDetailsFragment"
        android:label="Post Details">
        <argument
            android:name="postId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/createPostFragment"
        android:name="com.pawfinder.app.ui.post.CreatePostFragment"
        android:label="Create Post" />

    <fragment
        android:id="@+id/myPostsFragment"
        android:name="com.pawfinder.app.ui.myposts.MyPostsFragment"
        android:label="My Posts">
        <action
            android:id="@+id/action_myPostsFragment_to_editPostFragment"
            app:destination="@id/editPostFragment" />
        <action
            android:id="@+id/action_myPostsFragment_to_postDetailsFragment"
            app:destination="@id/postDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.pawfinder.app.ui.profile.ProfileFragment"
        android:label="Profile" />

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.pawfinder.app.ui.profile.EditProfileFragment"
        android:label="Edit Profile" />

    <fragment
        android:id="@+id/editPostFragment"
        android:name="com.pawfinder.app.ui.post.EditPostFragment"
        android:label="Edit Post">
        <argument
            android:name="postId"
            app:argType="string" />
    </fragment>

</navigation>